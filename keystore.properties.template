# Release signing credentials for BubuProtect.
#
# Copy this file to `keystore.properties` in the project root and fill in your own values. That file
# is gitignored; this template is not, and must never contain real values.
#
# On CI, skip the file and set these environment variables instead:
#   BUBU_STORE_FILE, BUBU_STORE_PASSWORD, BUBU_KEY_ALIAS, BUBU_KEY_PASSWORD
#
# To create a keystore (run it yourself so the passwords stay yours):
#
#   keytool -genkeypair -v \
#     -keystore bubuprotect.jks \
#     -alias bubuprotect \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12
#
# Back the .jks up somewhere you will still have in five years. If you lose it you cannot ever
# publish an update under the package name com.personal.bubuprotect again; if it leaks, someone else
# can publish an update that Android accepts as genuinely yours.

# Path to the keystore, relative to the project root (or absolute).
storeFile=bubuprotect.jks

# Password for the keystore file.
storePassword=

# The key inside the keystore, and its password. With -storetype PKCS12 the key password is the same
# as the store password.
keyAlias=bubuprotect
keyPassword=
