<?xml version="1.0" encoding="utf-8"?>
<!--
    Belt-and-braces for API < 31. android:allowBackup="false" already disables backup;
    these excludes make sure nothing leaks even if that attribute is ever flipped.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
