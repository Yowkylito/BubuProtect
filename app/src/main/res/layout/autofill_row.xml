<?xml version="1.0" encoding="utf-8"?>
<!--
    One suggestion in the system's autofill dropdown.

    Kept to LinearLayout, ImageView and TextView because that is what RemoteViews can inflate - this
    is drawn by the system UI process, not by this app, so ConstraintLayout and anything Compose are
    both out. It is also why nothing here is `?attr`: theme attributes would resolve against the
    host's theme.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/autofill_surface"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/autofill_row_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_kind_login" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/autofill_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/autofill_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autofill_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/autofill_subtitle"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
